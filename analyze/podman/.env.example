# Copy to .env and replace every value before starting the stack.
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=replace-with-a-long-unique-password
INFLUX_ORG=where-to-tls
INFLUX_BUCKET=k6
INFLUX_TOKEN=replace-with-a-long-random-api-token
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-unique-password
GRAFANA_QUERY_TIMEOUT_SECONDS=120
GRAFANA_MAX_CONNS_PER_HOST=4
# Configure exactly one importer source.
# Local results: set IMPORT_RESULTS_DIR=/results and COMPOSE_RESULTS_DIR to its
# absolute host path, then use `make analyze-up`.
IMPORT_RESULTS_DIR=
IMPORT_ARTIFACT_DIR=
IMPORT_WORKERS=16
# Set true to exclude raw k6 points tagged warmup=true from a new import.
IMPORT_SKIP_WARMUP=false
# OCI artifacts: leave the fields above blank and provide whitespace-separated
# references to `make analyze-up-oci`.
IMPORT_ARTIFACT_IMAGES=
# Legacy single-artifact variable; leave blank when using IMPORT_ARTIFACT_IMAGES.
IMPORT_ARTIFACT_IMAGE=