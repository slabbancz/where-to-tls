        <mxCell id="18" parent="1" value="New request: allocate socket / connect()&lt;br&gt;select eligible local IP + ephemeral port" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#9673a6;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="325" as="sourcePoint" />
            <mxPoint x="760" y="325" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="19" parent="1" value="TCP SYN: client SYN_SENT; server LISTEN -&gt; SYN_RECV" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#666666;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="395" as="sourcePoint" />
            <mxPoint x="1360" y="395" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="20" parent="1" value="TCP SYN/ACK: acknowledges client SYN" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#666666;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1360" y="465" as="sourcePoint" />
            <mxPoint x="760" y="465" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="21" parent="1" value="TCP ACK: completes 3-way handshake; both ESTABLISHED" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#666666;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="535" as="sourcePoint" />
            <mxPoint x="1360" y="535" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="22" parent="1" value="TLS 1.2 ClientHello: supported suites, SNI, ALPN offers" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#0066cc;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="605" as="sourcePoint" />
            <mxPoint x="1660" y="605" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="23" parent="1" value="ServerHello: TLS 1.2, selected ECDHE/ECDSA AES-GCM suite, ALPN h2" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#0066cc;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1660" y="675" as="sourcePoint" />
            <mxPoint x="460" y="675" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="24" parent="1" value="Certificate + signed ephemeral ServerKeyExchange + ServerHelloDone&lt;br&gt;full ECDHE handshake; logical messages, may share TCP segments" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#0066cc;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1660" y="745" as="sourcePoint" />
            <mxPoint x="460" y="745" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="25" parent="1" value="Verify server certificate / hostname&lt;br&gt;and key-exchange signature" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#999999;fontSize=12;spacing=12;align=left;">
          <mxGeometry x="330" y="790" width="260" height="62" as="geometry" />
        </mxCell>
        <mxCell id="26" parent="1" value="ClientKeyExchange (ECDHE public key) + ChangeCipherSpec + encrypted Finished" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#0066cc;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="885" as="sourcePoint" />
            <mxPoint x="1660" y="885" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="27" parent="1" value="ChangeCipherSpec + encrypted Finished&lt;br&gt;both peers verify Finished; TLS ready" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#0066cc;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1660" y="955" as="sourcePoint" />
            <mxPoint x="460" y="955" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="28" parent="1" value="HTTP/2 connection preface + client SETTINGS (inside TLS records)" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#2d7600;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="1025" as="sourcePoint" />
            <mxPoint x="1960" y="1025" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="29" parent="1" value="Server SETTINGS; SETTINGS acknowledgments in both directions&lt;br&gt;Logical exchange; may interleave with requests. Routine TCP ACKs omitted." edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#2d7600;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1960" y="1095" as="sourcePoint" />
            <mxPoint x="160" y="1095" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="30" parent="1" value="HTTP/2 HEADERS: GET /payload?bytes=1024&lt;br&gt;encoded -&gt; TLS records -&gt; TCP stream" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#2d7600;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="1165" as="sourcePoint" />
            <mxPoint x="1960" y="1165" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="31" parent="1" value="HTTP/2 response HEADERS + DATA; request succeeds&lt;br&gt;frames 210, 212" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#2d7600;strokeWidth=2;dashed=0;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1960" y="1235" as="sourcePoint" />
            <mxPoint x="160" y="1235" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="32" parent="1" value="No connection reuse:&lt;br&gt;HTTP transport closes TLS connection" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#9673a6;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="1305" as="sourcePoint" />
            <mxPoint x="460" y="1305" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="33" parent="1" value="crypto/tls.Close():&lt;br&gt;write encrypted close_notify" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#9673a6;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="1375" as="sourcePoint" />
            <mxPoint x="760" y="1375" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="34" parent="1" value="Client TLS close_notify: 31 TCP payload bytes&lt;br&gt;frame 216" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#0066cc;strokeWidth=2;dashed=0;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="1445" as="sourcePoint" />
            <mxPoint x="1360" y="1445" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="35" parent="1" value="Close underlying net.Conn&lt;br&gt;without waiting for peer TLS alert" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#9673a6;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="1515" as="sourcePoint" />
            <mxPoint x="760" y="1515" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="36" parent="1" value="Client FIN/ACK: FIN_WAIT_1; peer TCP enters CLOSE_WAIT&lt;br&gt;frame 219" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#666666;strokeWidth=2;dashed=0;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="1585" as="sourcePoint" />
            <mxPoint x="1360" y="1585" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="37" parent="1" value="Deliver received TLS record bytes&lt;br&gt;TCP FIN separately ends byte stream" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#9673a6;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1360" y="1655" as="sourcePoint" />
            <mxPoint x="1660" y="1655" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="38" parent="1" value="Decode close_notify -&gt; TLS read EOF&lt;br&gt;HTTP/2 connection cleanup" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#9673a6;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1660" y="1725" as="sourcePoint" />
            <mxPoint x="1960" y="1725" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="39" parent="1" value="Deferred crypto/tls.Conn.Close()&lt;br&gt;attempt reciprocal TLS alert" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#9673a6;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1960" y="1795" as="sourcePoint" />
            <mxPoint x="1660" y="1795" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="40" parent="1" value="Write encrypted close_notify&lt;br&gt;then close underlying net.Conn" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#9673a6;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1660" y="1865" as="sourcePoint" />
            <mxPoint x="1360" y="1865" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="41" parent="1" value="Reciprocal TLS close_notify: 31 new TCP bytes; frame 278&lt;br&gt;ACK covers client FIN (FIN_WAIT_2 or transient full-socket close path)" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#0066cc;strokeWidth=2;dashed=0;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1360" y="1935" as="sourcePoint" />
            <mxPoint x="760" y="1935" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="42" parent="1" value="Receive side already closed:&lt;br&gt;new payload can trigger Linux reset;&lt;br&gt;exact kernel branch not traced" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#999999;fontSize=12;spacing=12;align=left;">
          <mxGeometry x="630" y="1980" width="260" height="62" as="geometry" />
        </mxCell>
        <mxCell id="43" parent="1" value="Client RST - frame 279, 12 microseconds after alert&lt;br&gt;abort rather than normal client TIME_WAIT" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#b85450;strokeWidth=2;dashed=0;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="2075" as="sourcePoint" />
            <mxPoint x="1360" y="2075" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="44" parent="1" value="Server FIN/ACK - frame 281&lt;br&gt;in-flight close races with reset; FIN sequence follows the 31 alert bytes" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#666666;strokeWidth=2;dashed=0;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1360" y="2145" as="sourcePoint" />
            <mxPoint x="760" y="2145" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="45" parent="1" value="ANOTHER client RST - frame 282&lt;br&gt;late FIN does not receive a normal final ACK" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#b85450;strokeWidth=2;dashed=0;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="2215" as="sourcePoint" />
            <mxPoint x="1360" y="2215" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="46" parent="1" value="Reset cleanup: no normal TIME_WAIT&lt;br&gt;for this stream; tuple becomes eligible&lt;br&gt;subject to normal allocation rules" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#999999;fontSize=12;spacing=12;align=left;">
          <mxGeometry x="630" y="2260" width="260" height="62" as="geometry" />
        </mxCell>
        <mxCell id="47" parent="1" value="Accepted reset aborts remaining TCP&lt;br&gt;state. CLOSED; no ACK of a RST.&lt;br&gt;Internal timing not captured." vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#999999;fontSize=12;spacing=12;align=left;">
          <mxGeometry x="1230" y="2330" width="260" height="62" as="geometry" />
        </mxCell>
        <mxCell id="48" parent="1" value="Evidence and scope: docs/tls-exhaustion-go-vs-dotnet.md (Go stream 0 / .NET stream 1) and docs/tls-exhaustion-mechanism.md (pinned Go/.NET/Linux source links). Packet arrows cross the LB; it does not terminate TLS. TLS is userspace on these paths; the kernel interprets TCP bytes/sequence numbers, not HTTP or TLS alerts.&lt;br&gt;Handshake rows expand the full TLS 1.2 ECDHE protocol, not frame-by-frame capture timing. Optional branches and timer expiry are explanatory, not observed events for these exact streams. Reference Linux: v6.12; measured kernel: 7.0.0-1012-azure. Reset and normal-close populations coexist; these are representative paths, not universal runtime behavior." vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;spacing=12;align=left;">
          <mxGeometry x="40" y="2445" width="2040" height="125" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
