          </mxGeometry>
        </mxCell>
        <mxCell id="42" parent="1" value="Server sends TCP FIN/ACK&lt;br&gt;No new TLS data before the FIN" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#666666;strokeWidth=2;dashed=0;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
