          </mxGeometry>
        </mxCell>
        <mxCell id="encrypt" value="Encrypt HTTP/2 GOAWAY bytes&lt;br&gt;as TLS application-data record(s)&lt;br&gt;write to TCP" style="endArrow=classic;html=1;fontSize=13;dashed=1;strokeColor=#0066cc;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1660" y="1060" as="sourcePoint" />
            <mxPoint x="1360" y="1060" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="wiregoaway" value="New server TCP payload containing encrypted GOAWAY&lt;br&gt;crosses L4 LB; kernel cannot interpret HTTP/2 or TLS" style="endArrow=classic;html=1;fontSize=14;strokeColor=#d79b00;strokeWidth=3;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1360" y="1140" as="sourcePoint" />
            <mxPoint x="760" y="1140" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="closedreceiver" value="ILLUSTRATED RACE:&lt;br&gt;receive side already closed.&lt;br&gt;New payload can take TCP reset path." style="rounded=1;html=1;whiteSpace=wrap;align=left;spacing=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="625" y="1190" width="270" height="65" as="geometry" />
        </mxCell>
        <mxCell id="nodelivery" value="The client TLS/HTTP layers do not process GOAWAY on this reset path. TCP reacts to late payload, not GOAWAY semantics." style="rounded=1;html=1;whiteSpace=wrap;align=left;spacing=10;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="35" y="1190" width="550" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rst" value="Client TCP RST: abort instead of completing normal FIN teardown" style="endArrow=classic;html=1;fontSize=14;strokeColor=#b85450;strokeWidth=3;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="1320" as="sourcePoint" />
            <mxPoint x="1360" y="1320" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="clientend" value="Reset cleanup: no normal client&lt;br&gt;TIME_WAIT retention for this path.&lt;br&gt;Tuple eligibility follows kernel rules." style="rounded=1;html=1;whiteSpace=wrap;align=left;spacing=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="625" y="1380" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="serverend" value="Accepted RST aborts remaining TCP&lt;br&gt;state; CLOSED. No ACK of a RST.&lt;br&gt;Server TLS/HTTP cleanup completes." style="rounded=1;html=1;whiteSpace=wrap;align=left;spacing=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1225" y="1470" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="meaning" value="GOAWAY MAY PRECEDE DISPOSAL&lt;br&gt;Quiet TLS disposal concerns TLS close_notify. HTTP/2 cleanup can send GOAWAY first. NO_ERROR means no HTTP/2 protocol error; it says nothing about TCP teardown.&lt;br&gt;&lt;br&gt;OUTCOME DEPENDS ON TIMING&lt;br&gt;If the client can still receive, it can process GOAWAY. If not, late payload can lead to reset. Without extra output, page 5's normal-close path applies. Go also supports GOAWAY.&lt;br&gt;&lt;br&gt;Source references and limits: tls-exhaustion-mechanism.md." style="rounded=1;html=1;whiteSpace=wrap;align=left;spacing=12;fontSize=14;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="1640" width="2040" height="265" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
