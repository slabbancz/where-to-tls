            <mxPoint x="1660" y="605" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="23" parent="1" value="ServerHello: TLS 1.2, selected ECDHE/ECDSA AES-GCM suite, ALPN h2" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#0066cc;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1660" y="675" as="sourcePoint" />
            <mxPoint x="460" y="675" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="24" parent="1" value="Certificate + signed ephemeral ServerKeyExchange + ServerHelloDone&lt;br&gt;full ECDHE handshake; logical messages, may share TCP segments" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#0066cc;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1660" y="745" as="sourcePoint" />
            <mxPoint x="460" y="745" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="25" parent="1" value="Verify server certificate / hostname&lt;br&gt;and key-exchange signature" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#999999;fontSize=12;spacing=12;align=left;">
          <mxGeometry x="330" y="790" width="260" height="62" as="geometry" />
        </mxCell>
        <mxCell id="26" parent="1" value="ClientKeyExchange (ECDHE public key) + ChangeCipherSpec + encrypted Finished" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#0066cc;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="885" as="sourcePoint" />
            <mxPoint x="1660" y="885" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="27" parent="1" value="ChangeCipherSpec + encrypted Finished&lt;br&gt;both peers verify Finished; TLS ready" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#0066cc;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1660" y="955" as="sourcePoint" />
            <mxPoint x="460" y="955" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="28" parent="1" value="HTTP/2 connection preface + client SETTINGS (inside TLS records)" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#2d7600;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="1025" as="sourcePoint" />
            <mxPoint x="1960" y="1025" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="29" parent="1" value="Server SETTINGS; SETTINGS acknowledgments in both directions&lt;br&gt;Logical exchange; may interleave with requests. Routine TCP ACKs omitted." edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#2d7600;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1960" y="1095" as="sourcePoint" />
            <mxPoint x="160" y="1095" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="30" parent="1" value="HTTP/2 HEADERS: GET /payload?bytes=1024&lt;br&gt;encoded -&gt; TLS records -&gt; TCP stream" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#2d7600;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="1165" as="sourcePoint" />
            <mxPoint x="1960" y="1165" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="31" parent="1" value="HTTP/2 response HEADERS + DATA; request succeeds&lt;br&gt;frame 1241" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#2d7600;strokeWidth=2;dashed=0;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1960" y="1235" as="sourcePoint" />
            <mxPoint x="160" y="1235" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="32" parent="1" value="No connection reuse:&lt;br&gt;HTTP transport closes TLS connection" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#9673a6;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="1305" as="sourcePoint" />
            <mxPoint x="460" y="1305" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="33" parent="1" value="crypto/tls.Close():&lt;br&gt;write encrypted close_notify" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#9673a6;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="1375" as="sourcePoint" />
            <mxPoint x="760" y="1375" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="34" parent="1" value="Client TLS close_notify: 31 TCP payload bytes&lt;br&gt;frame 1258" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#0066cc;strokeWidth=2;dashed=0;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="1445" as="sourcePoint" />
            <mxPoint x="1360" y="1445" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="35" parent="1" value="Close underlying net.Conn&lt;br&gt;without waiting for peer TLS alert" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#9673a6;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="1515" as="sourcePoint" />
            <mxPoint x="760" y="1515" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="36" parent="1" value="Client FIN/ACK: FIN_WAIT_1; peer TCP enters CLOSE_WAIT&lt;br&gt;frame 1260" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#666666;strokeWidth=2;dashed=0;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="1585" as="sourcePoint" />
            <mxPoint x="1360" y="1585" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="37" parent="1" value="Deliver received TLS record bytes&lt;br&gt;TCP FIN separately ends byte stream" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#9673a6;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1360" y="1655" as="sourcePoint" />
            <mxPoint x="1660" y="1655" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="38" parent="1" value="Decode close_notify -&gt; TLS read EOF&lt;br&gt;HTTP/2 connection cleanup" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#9673a6;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1660" y="1725" as="sourcePoint" />
            <mxPoint x="1960" y="1725" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="39" parent="1" value="HTTPS cleanup disposes SslStream&lt;br&gt;ordinary quiet OpenSSL disposal" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#9673a6;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1960" y="1795" as="sourcePoint" />
            <mxPoint x="1660" y="1795" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="40" parent="1" value="No reciprocal close_notify or GOAWAY&lt;br&gt;in this representative stream.&lt;br&gt;No explicit ShutdownAsync() exchange." vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#999999;fontSize=12;spacing=12;align=left;">
          <mxGeometry x="1530" y="1840" width="260" height="62" as="geometry" />
        </mxCell>
        <mxCell id="41" parent="1" value="Connection transport cleanup&lt;br&gt;closes TCP (schematic ownership)" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#9673a6;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1660" y="1935" as="sourcePoint" />
            <mxPoint x="1360" y="1935" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="42" parent="1" value="Server FIN/ACK - frame 1738; LAST_ACK; zero payload&lt;br&gt;ACK covers client FIN; FIN seq 3374924439 matches client's next expected byte" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#666666;strokeWidth=2;dashed=0;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1360" y="2005" as="sourcePoint" />
            <mxPoint x="760" y="2005" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="43" parent="1" value="Accept ACK + FIN: FIN_WAIT_1 -&gt;&lt;br&gt;TIME_WAIT; FIN_WAIT_2 need not&lt;br&gt;be a separately observable state" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#999999;fontSize=12;spacing=12;align=left;">
          <mxGeometry x="630" y="2050" width="260" height="62" as="geometry" />
        </mxCell>
        <mxCell id="44" parent="1" value="Final ACK - frame 1739; ACK 3374924440 = FIN sequence + 1&lt;br&gt;server can leave LAST_ACK -&gt; CLOSED" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#666666;strokeWidth=2;dashed=0;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="2145" as="sourcePoint" />
            <mxPoint x="1360" y="2145" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="45" parent="1" value="TIME_WAIT: kernel keeps tuple /&lt;br&gt;sequence state, not an HTTP request.&lt;br&gt;No notification to application." vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#999999;fontSize=12;spacing=12;align=left;">
          <mxGeometry x="630" y="2190" width="260" height="62" as="geometry" />
        </mxCell>
        <mxCell id="46" parent="1" value="CLOSED: normal server socket cleanup.&lt;br&gt;No further TLS messages.&lt;br&gt;No ACK of the final ACK." vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#999999;fontSize=12;spacing=12;align=left;">
          <mxGeometry x="1230" y="2260" width="260" height="62" as="geometry" />
        </mxCell>
        <mxCell id="47" parent="1" value="OPTIONAL, not observed here: retransmitted FIN if final ACK was lost&lt;br&gt;(server would still be LAST_ACK)" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#666666;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1360" y="2355" as="sourcePoint" />
            <mxPoint x="760" y="2355" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="48" parent="1" value="OPTIONAL: TIME_WAIT responds with ACK again;&lt;br&gt;matching FIN can restart retention timer" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#666666;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="2425" as="sourcePoint" />
            <mxPoint x="1360" y="2425" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="49" parent="1" value="Normal no-new-traffic case:&lt;br&gt;TIME_WAIT timer expires (~60 s in&lt;br&gt;reference Linux); remove tuple state" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#999999;fontSize=12;spacing=12;align=left;">
          <mxGeometry x="630" y="2470" width="260" height="62" as="geometry" />
        </mxCell>
        <mxCell id="50" parent="1" value="CLOSED: tuple eligible for a new dial.&lt;br&gt;No FIN / RST / TLS alert at expiry.&lt;br&gt;New request must start with SYN." vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#999999;fontSize=12;spacing=12;align=left;">
          <mxGeometry x="630" y="2540" width="260" height="62" as="geometry" />
        </mxCell>
        <mxCell id="51" parent="1" value="Evidence and scope: docs/tls-exhaustion-go-vs-dotnet.md (Go stream 0 / .NET stream 1) and docs/tls-exhaustion-mechanism.md (pinned Go/.NET/Linux source links). Packet arrows cross the LB; it does not terminate TLS. TLS is userspace on these paths; the kernel interprets TCP bytes/sequence numbers, not HTTP or TLS alerts.&lt;br&gt;Handshake rows expand the full TLS 1.2 ECDHE protocol, not frame-by-frame capture timing. Optional branches and timer expiry are explanatory, not observed events for these exact streams. Reference Linux: v6.12; measured kernel: 7.0.0-1012-azure. Reset and normal-close populations coexist; these are representative paths, not universal runtime behavior." vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;spacing=12;align=left;">
          <mxGeometry x="40" y="2655" width="2040" height="125" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
