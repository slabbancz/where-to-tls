        <mxCell id="22" parent="1" value="TLS 1.2 ClientHello: supported suites, SNI, ALPN offers" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#0066cc;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
