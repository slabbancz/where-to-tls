        <mxCell id="30" parent="1" value="HTTP/2 HEADERS - GET" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#2d7600;strokeWidth=2;dashed=0;labelBackgroundColor=#ffffff;">
