        <mxCell id="21" parent="1" value="TCP ACK: completes 3-way handshake; both ESTABLISHED" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#666666;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
