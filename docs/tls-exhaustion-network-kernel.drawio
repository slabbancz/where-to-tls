          </mxGeometry>
        </mxCell>
        <mxCell id="states" value="PREDECESSOR CONNECTION STATE CHAIN&lt;br&gt;A prior successful .NET connection follows: ESTABLISHED → client FIN_WAIT_1 → server ACK → FIN_WAIT_2 → server FIN → client final ACK → TIME_WAIT. The retry that fails never reaches SYN_SENT because tuple allocation fails first." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="1200" height="95" as="geometry" />
        </mxCell>
        <mxCell id="evidence" value="MEASURED EXHAUSTION&lt;br&gt;07:02:13.343 UTC first EADDRNOTAVAIL completion; 07:02:14.221, 28,232 occupied source ports; 07:02:19.120, 28,232 TIME_WAIT sockets. The exact pool-sized population is strong aggregate evidence, not a state-transition capture for every socket.&lt;br&gt;&lt;br&gt;This was not a Kestrel descriptor leak: server descriptors returned to baseline." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="830" width="1200" height="135" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
