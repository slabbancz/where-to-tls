        <mxCell id="32" parent="1" value="No connection reuse: HTTP transport closes TLS&lt;br&gt;tls.Conn.Close()" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#9673a6;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="1305" as="sourcePoint" />
            <mxPoint x="460" y="1305" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="33" parent="1" value="Writes the encrypted TLS shutdown alert&lt;br&gt;closeNotify()" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#9673a6;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="1375" as="sourcePoint" />
            <mxPoint x="760" y="1375" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="34" parent="1" value="Client sends TLS close_notify&lt;br&gt;Signals closure of its TLS write direction" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#0066cc;strokeWidth=2;dashed=0;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="1445" as="sourcePoint" />
            <mxPoint x="1360" y="1445" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="35" parent="1" value="Closes TCP without waiting for peer alert&lt;br&gt;net.Conn.Close()" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#9673a6;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="1515" as="sourcePoint" />
            <mxPoint x="760" y="1515" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="36" parent="1" value="Client sends TCP FIN/ACK&lt;br&gt;Closes its sending direction" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#666666;strokeWidth=2;dashed=0;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="1585" as="sourcePoint" />
            <mxPoint x="1360" y="1585" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="37" parent="1" value="Reads encrypted TLS bytes&lt;br&gt;net.Conn.Read()" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#9673a6;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1360" y="1655" as="sourcePoint" />
            <mxPoint x="1660" y="1655" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="38" parent="1" value="HTTP/2 cleanup begins&lt;br&gt;tls.Conn.Read() returns io.EOF" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#9673a6;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1660" y="1725" as="sourcePoint" />
            <mxPoint x="1960" y="1725" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="39" parent="1" value="Go closes the server TLS connection&lt;br&gt;tls.Conn.Close()" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#9673a6;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1960" y="1795" as="sourcePoint" />
            <mxPoint x="1660" y="1795" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="40" parent="1" value="Writes the TLS alert, then closes TCP&lt;br&gt;closeNotify(), then net.Conn.Close()" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#9673a6;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1660" y="1865" as="sourcePoint" />
            <mxPoint x="1360" y="1865" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="41" parent="1" value="Server TLS close_notify + TCP ACK&lt;br&gt;ACK acknowledges the client FIN" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#0066cc;strokeWidth=2;dashed=0;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1360" y="1935" as="sourcePoint" />
            <mxPoint x="760" y="1935" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="42" parent="1" value="net.Conn.Close() closed the receive side&lt;br&gt;Linux rejects late TLS bytes with RST" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#999999;fontSize=12;spacing=12;align=left;">
          <mxGeometry x="630" y="1980" width="260" height="62" as="geometry" />
        </mxCell>
        <mxCell id="43" parent="1" value="Client sends TCP RST&lt;br&gt;Aborts the connection" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#b85450;strokeWidth=2;dashed=0;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="2075" as="sourcePoint" />
            <mxPoint x="1360" y="2075" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="44" parent="1" value="Server FIN/ACK arrives late&lt;br&gt;Its close crosses the client reset" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#666666;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1360" y="2145" as="sourcePoint" />
            <mxPoint x="760" y="2145" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="45" parent="1" value="Client sends another RST&lt;br&gt;Rejects the late server FIN" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#b85450;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="2215" as="sourcePoint" />
            <mxPoint x="1360" y="2215" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="46" parent="1" value="No normal client TIME_WAIT&lt;br&gt;on this reset path" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#999999;fontSize=12;spacing=12;align=left;">
          <mxGeometry x="630" y="2260" width="260" height="62" as="geometry" />
        </mxCell>
        <mxCell id="47" parent="1" value="Server accepts the reset&lt;br&gt;Closes its remaining TCP state" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#999999;fontSize=12;spacing=12;align=left;">
          <mxGeometry x="1230" y="2330" width="260" height="62" as="geometry" />
        </mxCell>
        <mxCell id="48" parent="1" value="WHY RST: the client has fully closed its socket. The server alert contains new TCP payload that the application can no longer receive. Linux sends RST; it does not interpret TLS close_notify.&lt;br&gt;WHY TIMING MATTERS: if the alert arrives before receive shutdown, TCP can accept it and close normally. Sending FIN alone only closes the write direction; it does not require a reset. Sources: tls-exhaustion-mechanism.md." vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;spacing=12;align=left;">
          <mxGeometry x="40" y="2445" width="2040" height="205" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
