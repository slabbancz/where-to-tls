            <mxPoint x="760" y="2005" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="43" parent="1" value="Client accepts the server FIN&lt;br&gt;Enters TIME_WAIT" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#999999;fontSize=12;spacing=12;align=left;">
          <mxGeometry x="630" y="2050" width="260" height="62" as="geometry" />
        </mxCell>
        <mxCell id="44" parent="1" value="Client sends final TCP ACK&lt;br&gt;Acknowledges the server FIN" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#666666;strokeWidth=2;dashed=0;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="2145" as="sourcePoint" />
            <mxPoint x="1360" y="2145" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="45" parent="1" value="Client keeps TIME_WAIT state&lt;br&gt;Retains the connection's IPs and ports" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#999999;fontSize=12;spacing=12;align=left;">
          <mxGeometry x="630" y="2190" width="260" height="62" as="geometry" />
        </mxCell>
        <mxCell id="46" parent="1" value="Server receives the final ACK&lt;br&gt;Closes its TCP state" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#999999;fontSize=12;spacing=12;align=left;">
          <mxGeometry x="1230" y="2260" width="260" height="62" as="geometry" />
        </mxCell>
        <mxCell id="49" parent="1" value="Client TIME_WAIT timer expires&lt;br&gt;About 60 seconds in reference Linux" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#999999;fontSize=12;spacing=12;align=left;">
          <mxGeometry x="630" y="2470" width="260" height="62" as="geometry" />
        </mxCell>
        <mxCell id="50" parent="1" value="Client releases the retained tuple&lt;br&gt;No packet is sent at expiry" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#999999;fontSize=12;spacing=12;align=left;">
          <mxGeometry x="630" y="2540" width="260" height="62" as="geometry" />
        </mxCell>
        <mxCell id="51" parent="1" value="Ordinary Kestrel/OpenSSL disposal sends no reciprocal TLS alert in this path.&lt;br&gt;Normal client-first TCP close retains TIME_WAIT. Sources: tls-exhaustion-mechanism.md." vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;spacing=12;align=left;">
          <mxGeometry x="40" y="2655" width="2040" height="205" as="geometry" />
        </mxCell>
