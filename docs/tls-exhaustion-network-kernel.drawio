        <mxCell id="18" parent="1" value="New request: allocate socket / connect()&lt;br&gt;select eligible local IP + ephemeral port" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#9673a6;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
