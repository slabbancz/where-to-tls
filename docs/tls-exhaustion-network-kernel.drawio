          </mxGeometry>
        </mxCell>
        <mxCell id="31" parent="1" value="HTTP/2 response HEADERS + DATA" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#2d7600;strokeWidth=2;dashed=0;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1960" y="1235" as="sourcePoint" />
            <mxPoint x="160" y="1235" as="targetPoint" />
          </mxGeometry>
