        </mxCell>
        <mxCell id="41" parent="1" value="Server closes TCP&lt;br&gt;Waits for its FIN to be acknowledged" edge="1" style="endArrow=classic;html=1;fontSize=13;strokeColor=#9673a6;strokeWidth=2;dashed=1;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry">
