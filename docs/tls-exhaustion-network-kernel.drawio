        <mxCell id="2" parent="1" value="Go: SYN to TLS handshake to HTTP response to final kernel cleanup" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#999999;fontSize=24;spacing=12;align=left;">
          <mxGeometry x="40" y="20" width="2040" height="55" as="geometry" />
        </mxCell>
        <mxCell id="3" parent="1" value="HTTP/2 over TLS 1.2, not HTTP/1.1. Client: k6 / Go TLS in BOTH runs. OSI: HTTP is L7, TCP is L4; TLS sits above TCP (often mapped to L5/L6), not separate implemented OSI session/presentation stacks.&lt;br&gt;Solid numbered messages = decoded capture evidence. Dashed messages = protocol expansion / source-based interpretation, NOT recorded syscalls or exact packet segmentation. Time runs downward; spacing is not elapsed time." vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;spacing=12;align=left;">
          <mxGeometry x="40" y="85" width="2040" height="100" as="geometry" />
        </mxCell>
        <mxCell id="4" parent="1" value="CLIENT HTTP - L7&lt;br&gt;k6 / Go HTTP transport" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#999999;fontSize=14;spacing=12;align=left;">
