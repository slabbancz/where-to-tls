{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["enabled", "startupProbe", "livenessProbe", "readinessProbe", "labels", "image", "imagePullSecrets", "config", "tls", "service", "scheduling", "resources", "global"],
  "additionalProperties": false,
  "definitions": {
    "probeToggle": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": {"enabled": {"type": "boolean"}}
    }
  },
  "properties": {
    "enabled": {"type": "boolean"},
    "startupProbe": {"$ref": "#/definitions/probeToggle"},
    "livenessProbe": {"$ref": "#/definitions/probeToggle"},
    "readinessProbe": {"$ref": "#/definitions/probeToggle"},
    "labels": {
      "type": "object",
      "required": ["scenario", "stack", "tls"],
      "additionalProperties": false,
      "properties": {
        "scenario": {"type": "string", "minLength": 1},
        "stack": {"type": "string", "enum": ["go", "net10", "net11", "java-netty", "rust"]},
        "tls": {"type": "string", "enum": ["pod", "traefik", "none"]}
      }
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "additionalProperties": false,
      "properties": {"repository": {"type": "string", "minLength": 1}}
    },
    "imagePullSecrets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {"name": {"type": "string", "minLength": 1}}
      }
    },
    "config": {
      "type": "object",
      "required": ["plaintextPort", "tls", "payload", "timeouts"],
      "additionalProperties": false,
      "properties": {
        "plaintextPort": {"type": "integer", "const": 8080},
        "tls": {
          "type": "object",
          "required": ["enabled", "port", "version", "resumption"],
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "port": {"type": "integer", "const": 8443},
            "version": {"type": "string", "enum": ["1.2", "1.3"]},
            "group": {"type": "string", "enum": ["P-256", "X25519"]},
            "provider": {"type": "string", "enum": ["boringssl", "jdk"]},
            "resumption": {"type": "boolean"}
          }
        },
        "payload": {
          "type": "object",
          "required": ["preallocate"],
          "additionalProperties": false,
          "properties": {"preallocate": {"type": "boolean"}}
        },
        "timeouts": {
          "type": "object",
          "required": ["tlsHandshakeSeconds", "httpRequestSeconds"],
          "additionalProperties": false,
          "properties": {
            "tlsHandshakeSeconds": {"type": "integer", "minimum": 1, "maximum": 300},
            "httpRequestSeconds": {"type": "integer", "minimum": 1, "maximum": 300}
          }
        }
      }
    },
    "tls": {
      "type": "object",
      "required": ["secretName", "mountPath", "certFile", "keyFile"],
      "additionalProperties": false,
      "properties": {
        "secretName": {"type": "string", "minLength": 1},
        "mountPath": {"type": "string", "const": "/etc/wtt/tls"},
        "certFile": {"type": "string", "const": "/etc/wtt/tls/tls.crt"},
        "keyFile": {"type": "string", "const": "/etc/wtt/tls/tls.key"}
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "annotations", "tlsPort", "plainPort"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "enum": ["LoadBalancer", "ClusterIP"]},
        "annotations": {"type": "object"},
        "tlsPort": {"type": "integer", "const": 8443},
        "plainPort": {"type": "integer", "const": 8080}
      }
    },
    "scheduling": {
      "type": "object",
      "required": ["nodeSelector"],
      "additionalProperties": false,
      "properties": {
        "nodeSelector": {
          "type": "object",
          "required": ["wtt/pool"],
          "additionalProperties": false,
          "properties": {"wtt/pool": {"type": "string", "const": "workload"}}
        }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests"],
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "required": ["cpu", "memory"],
          "additionalProperties": false,
          "properties": {
            "cpu": {"type": "string", "minLength": 1},
            "memory": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "global": {
      "type": "object",
      "required": ["image"],
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "required": ["registry", "tag", "pullPolicy"],
          "additionalProperties": false,
          "properties": {
            "registry": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1, "not": {"const": "latest"}},
            "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
          }
        }
      }
    }
  }
}
